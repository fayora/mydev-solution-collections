{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.24.24.22086",
      "templateHash": "1816428178073284583"
    }
  },
  "parameters": {
    "VirtualMachineName": {
      "type": "string",
      "defaultValue": "MyVm",
      "minLength": 4,
      "maxLength": 64,
      "metadata": {
        "description": "The name you want to give your workstation. The name can only contain letters, numbers, '.', and '-'."
      }
    },
    "Size": {
      "type": "string",
      "defaultValue": "Standard: 4/8/16 CPUs, 16/32/64 GiB of RAM",
      "allowedValues": [
        "Standard: 4/8/16 CPUs, 16/32/64 GiB of RAM",
        "Performance: newer 4/8/16 CPUs, 8/16/32 GiB of faster RAM"
      ],
      "metadata": {
        "description": "Select the size of the workstation."
      }
    },
    "adminUsername": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "metadata": {
        "description": "The username for the Administrator's account. A username must only contain letters, numbers, hyphens, and underscores and may not start with a hyphen or number."
      }
    },
    "adminPassword": {
      "type": "securestring",
      "minLength": 12,
      "maxLength": 72,
      "metadata": {
        "description": "Password for the workstation. It must be at least 12 characters long, and have 3 of the following: 1 lower case character, 1 upper case character, 1 number, and 1 special character."
      }
    },
    "enableSpot": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "DO NOT DISABLE SPOT, unless you are confident you want to do this. Spot is a great way to save up to 80% on your compute costs."
      }
    }
  },
  "variables": {
    "copy": [
      {
        "name": "VirtualMachineNameStrArr",
        "count": "[length(range(0, length(parameters('VirtualMachineName'))))]",
        "input": "[substring(parameters('VirtualMachineName'), range(0, length(parameters('VirtualMachineName')))[copyIndex('VirtualMachineNameStrArr')], 1)]"
      },
      {
        "name": "VirtualMachineNameStrCleaned",
        "count": "[length(variables('VirtualMachineNameStrArr'))]",
        "input": "[if(contains(variables('acceptedChars'), variables('VirtualMachineNameStrArr')[copyIndex('VirtualMachineNameStrCleaned')]), variables('VirtualMachineNameStrArr')[copyIndex('VirtualMachineNameStrCleaned')], '_')]"
      }
    ],
    "$fxv#1": {
      "StandardB": {
        "Description": "Standard B series VMs are burstable VMs that provide a cost-effective option for workloads that do not require continuous full CPU performance. They accumulate credits when underutilized, which can be used to burst to higher performance when needed.",
        "small": {
          "SKU": "Standard_B4as_v2",
          "Name": "4 CPUs, 16GiB of RAM",
          "Description": ""
        },
        "medium": {
          "SKU": "Standard_B8as_v2",
          "Name": "8 CPUs, 32GiB of RAM",
          "Description": ""
        },
        "large": {
          "SKU": "Standard_B16as_v2",
          "Name": "16 CPUs, 64GiB of RAM",
          "Description": ""
        }
      },
      "StandardD": {
        "Description": "Standard D series VMs are general purpose VMs that offer a balanced CPU-to-memory ratio. They are suitable for a wide variety of workloads, including web servers, small to medium databases, and application servers.",
        "small": {
          "SKU": "Standard_D4as_v6",
          "Name": "4 CPUs, 16GiB of RAM",
          "Description": ""
        },
        "medium": {
          "SKU": "Standard_D8as_v6",
          "Name": "8 CPUs, 32GiB of RAM",
          "Description": ""
        },
        "large": {
          "SKU": "Standard_D16as_v6",
          "Name": "16 CPUs, 64GiB of RAM",
          "Description": ""
        }
      }
    },
    "acceptedChars": [
      "a",
      "b",
      "c",
      "d",
      "e",
      "f",
      "g",
      "h",
      "i",
      "j",
      "k",
      "l",
      "m",
      "n",
      "o",
      "p",

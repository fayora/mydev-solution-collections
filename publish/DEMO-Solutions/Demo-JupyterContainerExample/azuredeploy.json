{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "ContainerSize": {
            "defaultValue": "CPU: 1 vCPUs, 2 GiB RAM",
            "type": "string",
            "metadata": {
                "description": "The size of the container to deploy."
            },
            "allowedValues": [
                "CPU: 1 vCPUs, 2 GiB RAM",
                "CPU: 2 vCPUs, 4 GiB RAM",
                "CPU: 4 vCPUs, 8 GiB RAM"
            ]
        },
        "accessToken": {
            "type": "securestring",
            "minLength": 12,
            "maxLength": 64,
            "metadata": {
                "description": "The access token to secure access to the Jupyter Notebook. Similar to a password. It must be at least 12 characters long, have one uppercase letter, one lowercase letter, one number, and one special character.",
                "regex": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[^\\w\\s]).{12,64}$",
                "validationMessage": "The token must be 12-64 characters long and include at least one uppercase letter, one lowercase letter, one number, and one special character."
            }
        }
    },
    "variables": {
        "containerBaseName": "jupyter-container",
        "containerVersion": "2025-12-10",
        "containerRegistry": "ghcr.io",
        "containerImage": "ghcr.io/fayora/jupyter-container:2025-12-10",
        "uniqueHash": "[uniqueString(deployment().properties.templateHash, deployment().name)]",
        "containerName": "[take(concat('jupyter-', variables('uniqueHash')), 24)]",
        "sanitisedContainerName": "[toLower(replace(replace(trim(variables('containerName')), ' ', '-'), '_', '-'))]",
        "containerCPUs": {
            "CPU: 1 vCPUs, 2 GiB RAM": 1,
            "CPU: 2 vCPUs, 4 GiB RAM": 2,
            "CPU: 4 vCPUs, 8 GiB RAM": 4
        },
        "containerMemory": {
            "CPU: 1 vCPUs, 2 GiB RAM": 2,
            "CPU: 2 vCPUs, 4 GiB RAM": 4,
            "CPU: 4 vCPUs, 8 GiB RAM": 8
        },
        "ports": [
            {
                "protocol": "TCP",
                "port": 8888
            }
        ],
        "dnsNameLabel": "[variables('sanitisedContainerName')]",
        "autoGeneratedDomainNameLabelScope": "ResourceGroupReuse",
        "ipAddressType": "Public",
        "restartPolicy": "Always",
        "sku": "Standard",
        "osType": "Linux",
        "numberCpuCores": "[variables('containerCPUs')[parameters('ContainerSize')]]",
        "memory": "[variables('containerMemory')[parameters('ContainerSize')]]",
        "availabilityZones": [
            "1"
        ],
        "location": "[resourceGroup().location]"
    },
    "resources": [
        {
            "type": "Microsoft.ContainerInstance/containerGroups",
            "apiVersion": "2022-10-01-preview",
            "name": "[variables('sanitisedContainerName')]",
            "location": "[variables('location')]",
            "zones": "[variables('availabilityZones')]",
            "properties": {
                "containers": [
                    {
                        "name": "[variables('sanitisedContainerName')]",
                        "properties": {
                            "image": "[variables('containerImage')]",
                            "resources": {
                                "requests": {
                                    "cpu": "[float(variables('numberCpuCores'))]",
                                    "memoryInGB": "[float(variables('memory'))]"
                                }
                            },
                            "environmentVariables": [
                                {
                                    "name": "JUPYTER_TOKEN",
                                    "value": "[parameters('accessToken')]"
                                }
                            ],
                            "ports": "[variables('ports')]"
                        }
                    }
                ],
                "restartPolicy": "[variables('restartPolicy')]",
                "osType": "[variables('osType')]",
                "sku": "[variables('sku')]",
                "ipAddress": {
                    "type": "[variables('ipAddressType')]",
                    "ports": "[variables('ports')]",
                    "dnsNameLabel": "[variables('dnsNameLabel')]",
                    "autoGeneratedDomainNameLabelScope": "[variables('autoGeneratedDomainNameLabelScope')]"
                }
            }
        }
    ],
    "outputs": {
        "ContainerURI": {
            "type": "string",
            "value": "[concat('http://', reference(resourceId('Microsoft.ContainerInstance/containerGroups', variables('sanitisedContainerName'))).ipAddress.fqdn, ':8888')]"
        },
        "containerInstanceName": {
            "type": "string",
            "value": "[variables('sanitisedContainerName')]"
        }
    }
}